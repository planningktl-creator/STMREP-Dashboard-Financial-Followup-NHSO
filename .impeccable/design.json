    {
      "name": "Working Sheet",
      "kind": "card",
      "refersTo": "sheet",
      "description": "A flat white section with a ruled header.",
      "html": "<section class=\"ds-sheet\"><header class=\"ds-sheet-header\"><h2>บัญชีภาพรวม</h2><p>ทุกยอดมีที่มา</p></header><div class=\"ds-ledger\"><span>ค่าเรียกเก็บ HIS</span><strong>12,500.00 <small>บาท</small></strong></div></section>",
      "css": ".ds-sheet{border:1px solid var(--rule,#dce4eb);background:white;border-radius:var(--radius,6px);overflow:hidden;color:#213a43;font-family:'Noto Sans Thai',Tahoma,sans-serif}.ds-sheet-header{padding:18px 20px 15px;border-bottom:1px solid #e8edf2}.ds-sheet-header h2{font-size:16px;line-height:1.45;margin:0}.ds-sheet-header p{font-size:11px;color:var(--muted,#60747f);margin:5px 0 0}.ds-ledger{display:flex;align-items:center;justify-content:space-between;gap:15px;margin:0 20px;padding:14px 0;font-size:13px}.ds-ledger strong{font-size:20px;font-weight:600;color:#244451;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-ledger small{font-size:10px;color:var(--muted,#60747f);font-weight:400;margin-left:7px}"
    },
    {
      "name": "Folder Tabs",
      "kind": "nav",
      "refersTo": "folder-tab",
      "description": "Straight-baseline file tabs; lavender marks the selected panel.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"รายละเอียดแฟ้ม\"><button role=\"tab\" aria-selected=\"true\" tabindex=\"0\">ภาพรวม</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">รายการรักษา</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">หลักฐาน / Timeline</button></div>",
      "css": ".ds-tabs{display:flex;gap:4px;padding:0 20px;border-bottom:1px solid var(--rule,#dce4eb);overflow:auto}.ds-tabs button{background:#f0f3f7;border:1px solid var(--rule,#dce4eb);border-bottom:0;border-radius:7px 7px 0 0;min-height:39px;padding:9px 15px;color:#627482;font-family:'Noto Sans Thai',Tahoma,sans-serif;font-size:12px;white-space:nowrap;cursor:pointer;transition:background .16s,border-color .16s}.ds-tabs button[aria-selected=true]{background:var(--lavender,#eae6f5);color:#5b4d79;border-color:#d3cae7;font-weight:600}.ds-tabs button:hover{filter:brightness(.97)}.ds-tabs button:focus-visible{outline:3px solid #488dac;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-tabs button{transition:none}}"
    },
    {
      "name": "Evidence Rail",
      "kind": "custom",
      "refersTo": "evidence-rail",
      "description": "The square HIS → REP → STM source rail, stacked on small screens.",
      "html": "<section class=\"ds-rail\" aria-label=\"ขั้นตอนหลักฐานการเงิน\"><button><h2>HIS</h2><strong>1,240</strong><span>ครั้งรับบริการที่จัดช่วงเวลาได้</span></button><button><h2>REP</h2><strong>520,000.00</strong><span>ชดเชยส่วน สปสช. ที่จับคู่ได้</span></button><button><h2>STM</h2><strong>498,000.00</strong><span>ยอดสุทธิตาม statement ที่จับคู่ได้</span></button></section>",
      "css": ".ds-rail{display:flex;background:white;border:1px solid #cfdae4;border-top:3px solid var(--petrol,#12474f);border-radius:0;color:#213a43;font-family:'Noto Sans Thai',Tahoma,sans-serif}.ds-rail button{flex:1;min-width:0;display:flex;flex-direction:column;text-align:left;background:white;border:0;padding:20px 23px;gap:5px;color:inherit;font:inherit;cursor:pointer;transition:background .16s,border-color .16s}.ds-rail button:last-child{background:#faf9fd}.ds-rail h2{font-size:18px;line-height:1.45;margin:3px 0 8px;color:var(--petrol,#12474f)}.ds-rail strong{font-size:23px;line-height:1.35;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-rail span{font-size:12px;color:#3b5864}.ds-rail button:hover{filter:brightness(.97)}.ds-rail button:focus-visible{outline:3px solid #488dac;outline-offset:3px}@media(max-width:760px){.ds-rail{flex-direction:column}.ds-rail button{padding:16px 18px;border-bottom:1px solid var(--rule,#dce4eb)}.ds-rail strong{font-size:21px}}@media(prefers-reduced-motion:reduce){.ds-rail button{transition:none}}"
    }
