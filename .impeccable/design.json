  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A compact petrol action with visible keyboard focus.",
      "html": "<button class=\"ds-primary\">บันทึกงานติดตาม</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid transparent;border-radius:var(--radius,6px);padding:9px 14px;min-height:40px;font-family:'Noto Sans Thai',Tahoma,sans-serif;font-size:13px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background .16s,border-color .16s;background:var(--petrol,#12474f);color:var(--paper,#fff)}.ds-primary:hover:not(:disabled){filter:brightness(.97)}.ds-primary:disabled{cursor:not-allowed;opacity:.5}.ds-primary:focus-visible,.ds-secondary:focus-visible{outline:3px solid #488dac;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A white ruled action for supporting work.",
      "html": "<button class=\"ds-secondary\">โหลดข้อมูลใหม่</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid transparent;border-radius:var(--radius,6px);padding:9px 14px;min-height:40px;font-family:'Noto Sans Thai',Tahoma,sans-serif;font-size:13px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background .16s,border-color .16s;background:white;border-color:#cbd8e1;color:#234b58}.ds-secondary:hover:not(:disabled){filter:brightness(.97)}.ds-secondary:disabled{cursor:not-allowed;opacity:.5}.ds-primary:focus-visible,.ds-secondary:focus-visible{outline:3px solid #488dac;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Labelled Field",
      "kind": "input",
      "refersTo": "input",
      "description": "A permanent label above a white stroked input.",
      "html": "<label class=\"ds-field\">วันที่ติดตาม<input type=\"text\" placeholder=\"ระบุวันติดตาม\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:#213a43;font-family:'Noto Sans Thai',Tahoma,sans-serif;font-size:13px;font-weight:500}.ds-field input{font:inherit;border:1px solid #c8d4de;border-radius:var(--radius,6px);background:white;color:#213a43;min-height:40px;padding:8px 11px;min-width:0;caret-color:var(--petrol,#12474f)}.ds-field input::placeholder{color:var(--muted,#60747f);opacity:1}.ds-field input:focus-visible{outline:3px solid #488dac;outline-offset:3px}"
    },
    {
      "name": "Register Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Petrol index with a light current destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"เมนูหลัก\"><button aria-current=\"page\">ภาพรวมการเบิกจ่าย</button><button>แฟ้มรายเคส</button><button>คิวติดตาม</button></nav>",
      "css": ".ds-nav{display:grid;gap:5px;padding:12px;background:var(--petrol,#12474f)}.ds-nav button{display:flex;align-items:center;gap:11px;min-height:45px;border:0;background:transparent;color:#c6d9dc;text-align:left;padding:11px 12px;border-radius:5px;font-family:'Noto Sans Thai',Tahoma,sans-serif;font-size:13px;cursor:pointer;transition:background .16s,border-color .16s}.ds-nav button[aria-current=page]{background:#f0f5f6;color:var(--petrol,#12474f);font-weight:600}.ds-nav button:hover{filter:brightness(.97)}.ds-nav button:focus-visible{outline:3px solid #488dac;outline-offset:3px}@media(max-width:760px){.ds-nav{display:flex;overflow-x:auto;gap:6px}.ds-nav button{flex:none;min-height:38px;padding:8px 10px;font-size:11px}}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}"
    },
